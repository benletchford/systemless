# SheepShaver image used by `cargo run --bin play-sheepshaver`.
#
# The build clones a pinned macemu revision from GitHub, then applies a
# host-managed patch set copied into the Docker build context under
# `macemu-patches/`. This keeps the patch series outside the container
# while still producing a reproducible image. Interactive support comes
# from xdotool (keyboard/mouse injection into Xvfb) and imagemagick's
# `import` (window screenshots).

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV SDL_AUDIODRIVER=dummy
ENV SDL_RENDER_DRIVER=software

ARG MACEMU_REPO=https://github.com/cebix/macemu
ARG MACEMU_REF=96e512bd6376e78a2869f16dcc8a9028bce5ee72
LABEL org.opencontainers.image.source="${MACEMU_REPO}" \
      org.opencontainers.image.revision="${MACEMU_REF}"

RUN apt-get -y update && \
    apt-get install -y \
        git \
        build-essential \
        autoconf \
        automake \
        libsdl2-dev \
        libgtk2.0-dev \
        xvfb \
        x11-utils \
        hfsutils \
        xdotool \
        imagemagick \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Clone, optionally patch, link shared components, and build SheepShaver.
#   --enable-vosf: tracks direct framebuffer writes made by DrawSprocket games.
#   --disable-jit-compiler: JIT doesn't build deterministically across host arches
#                           and interpreter mode provides bit-exact stepping.
COPY apply_macemu_patches.sh /opt/apply_macemu_patches.sh
COPY macemu-patches /opt/macemu-patches
RUN chmod +x /opt/apply_macemu_patches.sh && \
    git clone "${MACEMU_REPO}" /opt/macemu && \
    test -n "${MACEMU_REF}" && \
    git -C /opt/macemu checkout "${MACEMU_REF}" && \
    test "$(git -C /opt/macemu rev-parse HEAD)" = "${MACEMU_REF}" && \
    echo "${MACEMU_REF}" > /opt/macemu-source-commit && \
    /opt/apply_macemu_patches.sh /opt/macemu /opt/macemu-patches

WORKDIR /opt/macemu/SheepShaver
RUN make links

WORKDIR /opt/macemu/SheepShaver/src/Unix
RUN NO_CONFIGURE=1 ./autogen.sh && \
    ./configure --enable-sdl-video --enable-sdl-audio --with-sdl2 --enable-vosf --disable-jit-compiler --enable-addressing=direct \
        CPPFLAGS="-DSTDC_HEADERS=1 -DHAVE_SIGINFO_T=1 -DHAVE_SIGSEGV_SKIP_INSTRUCTION=1" \
        CFLAGS="-DSTDC_HEADERS=1 -DHAVE_SIGINFO_T=1 -DHAVE_SIGSEGV_SKIP_INSTRUCTION=1 -g -O2" \
        CXXFLAGS="-DSTDC_HEADERS=1 -DHAVE_SIGINFO_T=1 -DHAVE_SIGSEGV_SKIP_INSTRUCTION=1 -g -O2" && \
    make -j$(nproc) && make install

WORKDIR /

COPY entrypoint_play.sh /entrypoint.sh
COPY .sheepshaver_prefs.play /root/.sheepshaver_prefs

RUN chmod +x /entrypoint.sh

VOLUME ["/mnt/shared"]

ENTRYPOINT ["/entrypoint.sh"]
