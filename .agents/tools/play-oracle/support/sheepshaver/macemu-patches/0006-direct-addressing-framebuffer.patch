diff --git a/BasiliskII/src/SDL/video_sdl.cpp b/BasiliskII/src/SDL/video_sdl.cpp
--- a/BasiliskII/src/SDL/video_sdl.cpp
+++ b/BasiliskII/src/SDL/video_sdl.cpp
@@ -201,13 +201,21 @@
 static void *vm_acquire_framebuffer(uint32 size)
 {
+#if DIRECT_ADDRESSING
+	return (void *)Mac2HostAddr(0x68000000);
+#else
 	void *fb = vm_acquire(size, VM_MAP_DEFAULT | VM_MAP_32BIT);
 	return fb;
+#endif
 }
 
 static inline void vm_release_framebuffer(void *fb, uint32 size)
 {
+#if !DIRECT_ADDRESSING
 	vm_release(fb, size);
+#endif
 }
 
 static inline int get_customized_color_depth(int default_depth)
