 #ifdef IDLE_USES_COND_WAIT
 	pthread_mutex_lock(&idle_lock);
 	pthread_cond_wait(&idle_cond, &idle_lock);
diff --git a/BasiliskII/src/uae_cpu/newcpu.h b/BasiliskII/src/uae_cpu/newcpu.h
