+	// Check for HFS+ wrapper embedding in MDB (block 2)
+	if (info.start_byte == 0) {
+		if (Sys_read(info.fh, map, 1024, 512) == 512) {
+			uint16 sig = (map[0] << 8) | map[1];
+			uint16 embed_sig = (map[124] << 8) | map[125];
+			if (sig == 0x4244 && embed_sig == 0x482b) {
+				uint32 al_blk_st = (map[28] << 8) | map[29];
+				uint32 al_blk_sz = (map[20] << 24) | (map[21] << 16) | (map[22] << 8) | map[23];
+				uint32 embed_start_blk = (map[126] << 8) | map[127];
+				uint32 embed_blk_cnt = (map[128] << 8) | map[129];
+				info.start_byte = (loff_t)(al_blk_st * 512) + (loff_t)(embed_start_blk * al_blk_sz);
+				info.num_blocks = (embed_blk_cnt * al_blk_sz) / 512;
+			}
+		}
+	}
 	delete[] map;
 }
 
