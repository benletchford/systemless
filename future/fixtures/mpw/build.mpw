PPCLink probe.ppc.o "{SharedLibraries}"InterfaceLib "{SharedLibraries}"StdCLib "{PPCLibraries}"StdCRuntime.o "{PPCLibraries}"PPCCRuntime.o -sym off -export main -init FutureInit -o probe.ppc
Rez -append -o probe.68k probe.r
Rez -append -o probe.ppc probe.r
