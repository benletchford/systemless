Set Echo 1
Set Exit 1
SC -sym off probe.c -o probe.68k.o
Link -d -t 'APPL' -c 'FUTR' probe.68k.o "{Libraries}"MacRuntime.o "{Libraries}"Interface.o -o probe.68k
MrC -sym off -opt off probe.c -o probe.ppc.o
PPCLink probe.ppc.o "{SharedLibraries}"InterfaceLib "{SharedLibraries}"StdCLib "{PPCLibraries}"StdCRuntime.o "{PPCLibraries}"PPCCRuntime.o -sym off -export main -init FutureInit -o probe.ppc
Rez -append -o probe.68k probe.r
Rez -append -o probe.ppc probe.r
MrC -sym off -opt off jump.c -o jump.ppc.o
PPCLink jump.ppc.o "{SharedLibraries}"StdCLib "{PPCLibraries}"StdCRuntime.o "{PPCLibraries}"PPCCRuntime.o -sym off -o jump.ppc
SC -sym off events.c -o events.68k.o
Link -d -t 'APPL' -c 'FUTR' events.68k.o "{Libraries}"MacRuntime.o "{Libraries}"Interface.o -o events.68k
MrC -sym off -opt off events.c -o events.ppc.o
PPCLink events.ppc.o "{SharedLibraries}"InterfaceLib "{SharedLibraries}"StdCLib "{PPCLibraries}"StdCRuntime.o "{PPCLibraries}"PPCCRuntime.o -sym off -o events.ppc
SC -sym off wait.c -o wait.68k.o
Link -d -t 'APPL' -c 'FUTR' wait.68k.o "{Libraries}"MacRuntime.o "{Libraries}"Interface.o -o wait.68k
MrC -sym off -opt off wait.c -o wait.ppc.o
PPCLink wait.ppc.o "{SharedLibraries}"InterfaceLib "{SharedLibraries}"StdCLib "{PPCLibraries}"StdCRuntime.o "{PPCLibraries}"PPCCRuntime.o -sym off -o wait.ppc
SC -sym off draw.c -o draw.68k.o
Link -d -t 'APPL' -c 'FUTR' draw.68k.o "{Libraries}"MacRuntime.o "{Libraries}"Interface.o -o draw.68k
MrC -sym off -opt off draw.c -o draw.ppc.o
PPCLink draw.ppc.o "{SharedLibraries}"InterfaceLib "{SharedLibraries}"StdCLib "{PPCLibraries}"StdCRuntime.o "{PPCLibraries}"PPCCRuntime.o -sym off -o draw.ppc
Rez -append -o draw.68k probe.r
Rez -append -o draw.ppc probe.r
