Link -d -t 'APPL' -c 'FUTR' wait.68k.o "{Libraries}"MacRuntime.o "{Libraries}"Interface.o -o wait.68k
MrC -sym off -opt off wait.c -o wait.ppc.o
PPCLink wait.ppc.o "{SharedLibraries}"InterfaceLib "{SharedLibraries}"StdCLib "{PPCLibraries}"StdCRuntime.o "{PPCLibraries}"PPCCRuntime.o -sym off -o wait.ppc
SC -sym off draw.c -o draw.68k.o
Link -d -t 'APPL' -c 'FUTR' draw.68k.o "{Libraries}"MacRuntime.o "{Libraries}"Interface.o -o draw.68k
MrC -sym off -opt off draw.c -o draw.ppc.o
PPCLink draw.ppc.o "{SharedLibraries}"InterfaceLib "{SharedLibraries}"StdCLib "{PPCLibraries}"StdCRuntime.o "{PPCLibraries}"PPCCRuntime.o -sym off -o draw.ppc
Rez -append -o draw.68k probe.r
Rez -append -o draw.ppc probe.r
MrC -sym off -opt off plugin.c -o plugin.ppc.o
PPCLink plugin.ppc.o "{SharedLibraries}"InterfaceLib -xm sharedlibrary -main PluginMain -init PluginInit -term PluginTerm -export PluginMain -sym off -o plugin.ppc
MrC -sym off -opt off dynamic.c -o dynamic.ppc.o
PPCLink dynamic.ppc.o "{SharedLibraries}"InterfaceLib "{SharedLibraries}"StdCLib "{PPCLibraries}"StdCRuntime.o "{PPCLibraries}"PPCCRuntime.o -sym off -o dynamic.ppc
Rez -append -o dynamic.ppc dynamic.r
SC -sym off windows.c -o windows.68k.o
Link -d -t 'APPL' -c 'FUTR' windows.68k.o "{Libraries}"MacRuntime.o "{Libraries}"Interface.o -o windows.68k
MrC -sym off -opt off windows.c -o windows.ppc.o
PPCLink windows.ppc.o "{SharedLibraries}"InterfaceLib "{SharedLibraries}"StdCLib "{PPCLibraries}"StdCRuntime.o "{PPCLibraries}"PPCCRuntime.o -sym off -o windows.ppc
SC -sym off textedit.c -o textedit.68k.o
Link -d -t 'APPL' -c 'FUTR' textedit.68k.o "{Libraries}"MacRuntime.o "{Libraries}"Interface.o -o textedit.68k
